{
  "name": "kolkata3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "npm run build && node tools/deploy/cloudflare.mjs",
    "data:fetch": "tsx tools/fetch-osm.ts",
    "data:build": "tsx tools/build-city.ts",
    "data:poi": "tsx tools/fetch-poi.ts",
    "data:wikidata": "tsx tools/fetch-wikidata.ts",
    "data:content": "tsx tools/fetch-landmark-content.ts",
    "data": "npm run data:fetch && npm run data:build"
  },
  "dependencies": {
    "earcut": "^3.2.4",
    "leaflet": "^1.9.4",
    "suncalc": "^2.1.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/proj4": "^2.5.6",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.187.0",
    "3d-tiles-renderer": "^0.5.4",
    "osmtogeojson": "^3.0.0-beta.5",
    "proj4": "^2.22.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
